# Server
PORT=3001
NODE_ENV=development

# Ticketmaster Discovery API - https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=your_ticketmaster_key

# Google Places API - https://console.cloud.google.com/apis/library/places-backend.googleapis.com
GOOGLE_PLACES_API_KEY=your_google_places_key

# Upstash Redis (OPTIONAL)
# Leave blank to use the built-in in-memory cache instead.
# https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# MongoDB (OPTIONAL - not currently bootstrapped by the server)
MONGODB_URI=
